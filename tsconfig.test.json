{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/game/**/*.ts",
    "tests/**/*.ts"
  ]
}
